---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, getLocalePath } from '../../../../i18n/utils';
import type { Lang, UiKey } from '../../../../i18n/ui';

export async function getStaticPaths() {
  return ['projects', 'events', 'thoughts', 'reviews'].map(category => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Category = 'projects' | 'events' | 'thoughts' | 'reviews';
const posts = (await getCollection(category as Category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const titleKeys: Record<string, UiKey> = {
  projects: 'cat.projects',
  events:   'cat.events',
  thoughts: 'cat.thoughts',
  reviews:  'cat.reviews',
};
const descKeys: Record<string, UiKey> = {
  projects: 'cat.projects.desc',
  events:   'cat.events.desc',
  thoughts: 'cat.thoughts.desc',
  reviews:  'cat.reviews.desc',
};

const title = t(titleKeys[category!] ?? 'blog.title');
const desc  = t(descKeys[category!]  ?? 'blog.subtitle');
---

<BaseLayout title={`${title} — HJP`} description={desc}>
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">

    <!-- Breadcrumb -->
    <nav class="text-sm text-[var(--text-muted)] mb-8">
      <a href={getLocalePath(lang, 'blog')} class="hover:text-[var(--accent)] transition-colors">Blog</a>
      <span class="mx-2">›</span>
      <span class="text-[var(--text)]">{title}</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-2">{title}</h1>
      <p class="text-[var(--text-muted)]">{desc}</p>
    </div>

    <!-- Posts -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {posts.map(post => (
          <PostCard post={post} category={category!} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center text-[var(--text-muted)]">
        <p class="text-4xl mb-4">✍️</p>
        <p class="italic">{t('blog.empty')}</p>
      </div>
    )}

  </div>
</BaseLayout>
