---
import { languages, type Lang } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);

// Build equivalent URL for each language
function getLangUrl(lang: Lang): string {
  const path = Astro.url.pathname;
  const langs = Object.keys(languages) as Lang[];

  // Remove current lang prefix if present
  let clean = path;
  for (const l of langs) {
    if (l === 'es') continue; // default has no prefix
    if (clean.startsWith(`/${l}/`)) { clean = clean.slice(l.length + 1); break; }
    if (clean === `/${l}`)          { clean = '/'; break; }
  }

  if (lang === 'es') return clean || '/';
  return `/${lang}${clean === '/' ? '' : clean}`;
}
---

<div class="relative group">
  <button
    class="flex items-center gap-1 text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text)] transition-colors px-2 py-1 rounded-lg border border-[var(--border)] hover:border-[var(--text)]"
    aria-label="Select language"
  >
    <span class="uppercase tracking-wide text-xs">{currentLang}</span>
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div class="absolute right-0 top-full mt-1 w-32 bg-[var(--bg)] border border-[var(--border)] rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
    {(Object.entries(languages) as [Lang, string][]).map(([lang, label]) => (
      <a
        href={getLangUrl(lang)}
        class={`flex items-center justify-between px-3 py-2 text-sm hover:bg-[var(--bg2)] first:rounded-t-lg last:rounded-b-lg transition-colors ${lang === currentLang ? 'text-[var(--accent)] font-medium' : 'text-[var(--text-muted)]'}`}
      >
        <span>{label}</span>
        {lang === currentLang && <span class="text-[var(--accent)]">✓</span>}
      </a>
    ))}
  </div>
</div>
