---
import PostCard from './PostCard.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang, UiKey } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

type AnyPost =
  | CollectionEntry<'projects'>
  | CollectionEntry<'events'>
  | CollectionEntry<'thoughts'>
  | CollectionEntry<'reviews'>;

interface Props {
  category:    string;
  titleKey:    UiKey;
  descKey:     UiKey;
  posts:       AnyPost[];
  lang:        Lang;
}

const { category, titleKey, descKey, posts, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-12 border-t border-[var(--border)]">
  <!-- Section header -->
  <div class="flex items-end justify-between mb-8">
    <div>
      <h2 class="font-serif text-2xl md:text-3xl font-bold">{t(titleKey)}</h2>
      <p class="text-sm text-[var(--text-muted)] mt-1">{t(descKey)}</p>
    </div>
    <a
      href={`/blog/${category}`}
      class="text-sm font-medium text-[var(--accent)] hover:opacity-80 transition-opacity whitespace-nowrap"
    >
      {t('blog.viewAll')} →
    </a>
  </div>

  <!-- Posts grid -->
  {posts.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {posts.map(post => (
        <PostCard post={post} category={category} lang={lang} />
      ))}
    </div>
  ) : (
    <p class="text-[var(--text-muted)] text-sm italic">{t('blog.empty')}</p>
  )}
</section>
