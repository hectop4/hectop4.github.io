---
import BaseLayout from './BaseLayout.astro';
import { getLangFromUrl, useTranslations, formatDate, readingTime, getLocalePath } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'projects'> | CollectionEntry<'events'> | CollectionEntry<'thoughts'> | CollectionEntry<'reviews'>;
  category: string;
  body: string;
}

const { post, category, body } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, date, tags, excerpt, item, itemType, itemAuthor, rating, spoilers } = post.data;
const mins = readingTime(body);

const typeLabels: Record<string, string> = {
  book:   t('type.book'),
  movie:  t('type.movie'),
  series: t('type.series'),
};

const categoryLabels: Record<string, string> = {
  projects: t('cat.projects'),
  events:   t('cat.events'),
  thoughts: t('cat.thoughts'),
  reviews:  t('cat.reviews'),
};
---

<BaseLayout title={`${title} — HJP`} description={excerpt}>
  <article class="max-w-5xl mx-auto px-6 py-16 md:py-24">

    <div class="max-w-3xl">

      <!-- Back link -->
      <a
        href={getLocalePath(lang, 'blog')}
        class="inline-flex items-center gap-2 text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors mb-10"
      >
        {t('post.back')}
      </a>

      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="tag tag-accent">{categoryLabels[category] ?? category}</span>
        {itemType && <span class="tag">{typeLabels[itemType]}</span>}
        <span class="tag">{post.data.lang.toUpperCase()}</span>
        {category === 'reviews' && spoilers && (
          <span class="tag flex items-center gap-1 border-amber-400/60 text-amber-600 dark:text-amber-400">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
            </svg>
            {t('review.spoilerBadge')}
          </span>
        )}
        {category === 'reviews' && !spoilers && (
          <span class="tag flex items-center gap-1 border-green-400/60 text-green-600 dark:text-green-400">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {t('review.noSpoilerBadge')}
          </span>
        )}
      </div>

      <!-- Title -->
      <h1 class="font-serif text-3xl md:text-5xl font-bold leading-tight mb-4">
        {title}
      </h1>

      <!-- Review meta -->
      {item && (
        <p class="text-[var(--text-muted)] text-base mb-2">
          {item}
          {itemAuthor && <span> — {t('post.by')} <em>{itemAuthor}</em></span>}
        </p>
      )}

      <!-- Star rating -->
      {rating && (
        <div class="stars flex gap-1 mb-4" aria-label={`${t('post.rating')}: ${rating}/5`}>
          {[1,2,3,4,5].map(n => (
            <span class={n <= rating ? 'filled' : ''} aria-hidden="true">★</span>
          ))}
        </div>
      )}

      <!-- Date & reading time -->
      <div class="flex items-center gap-3 text-sm text-[var(--text-muted)] mb-8">
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        <span>·</span>
        <span>{mins} {t('post.readingTime')}</span>
      </div>

      <hr class="section-rule mb-10" />

    </div>

    <!-- Content -->
    <div class="prose-hjp">
      <slot />
    </div>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="max-w-3xl mt-12 pt-8 border-t border-[var(--border)]">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)] mb-3">
          {t('post.tags')}
        </p>
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Author -->
    <div class="max-w-3xl mt-12 pt-8 border-t border-[var(--border)]">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)] mb-0.5">
        {t('post.writtenBy')}
      </p>
      <p class="font-serif font-bold text-[var(--text)]">Hector Puentes</p>
    </div>

  </article>
</BaseLayout>
